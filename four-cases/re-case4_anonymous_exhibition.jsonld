        {
          "id": "http://vocab.getty.edu/aat/300435416",
          "type": "Type",
          "_label": "Description"
        }
      ],
      "content": "The exhibition presents Hakka kung fu as a distinctive Southern Chinese martial arts system shaped by migration, lineage-based social organization, social conflict, and survival needs."
    },
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300026687",
          "type": "Type",
          "_label": "Credit/Acknowledgement"
        }
      ],
      "content": "Co-organizers: Intangible Cultural Heritage Office (LCSD) and International Guoshu Association. Curators: Hing Chao, Jeffrey Shaw, Sarah Kenderdine. Collaborators: Hakka Kung Fu Culture Research, ACIM CityU, Hong Kong Heritage Museum, Salon Films (H.K.) Ltd."
    },
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "http://vocab.getty.edu/aat/300435415",
          "type": "Type",
          "_label": "Note"
        }
      ],
      "content": "Digital resources used in the exhibition include the Re-Actor interactive installation (https://hkmala.org/resource/reactor), the Sei Moon Baak Daa MoCap animation Output V2 (https://hkmala.org/resource/mocap_animation_sei_moon_baak_daa_output_v2), and the Sei Moon Baak Daa motion capture data (https://hkmala.org/resource/mocap_data_sei_moon_baak_daa)."
    }
